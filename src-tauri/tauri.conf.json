{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Marketing Desktop",
  "version": "0.1.0",
  "identifier": "com.zrnown.discordmarketingsystemdesktop",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --dir frontend dev:desktop",
    "beforeBuildCommand": "pnpm --dir frontend build:desktop && python scripts/build_backend_sidecar.py"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Marketing Desktop",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/backend-api"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
